# Runtime-generated data
# Real-session telemetry is pulled through FastF1 and derived locally; it is
# regenerable from the pipeline and is not redistributed with the repository.
data/telemetry/
# Simulation outputs are regenerated by the runner and the plotting scripts.
# The two figures the README embeds live in docs/figures/ (exception below).
data/sim_results/
telemetry/*.csv
telemetry/*.bin
telemetry/*.json
!telemetry/.gitkeep
replays/*.chpatch
replays/*.bin
!replays/.gitkeep
plots/
figures/
!docs/figures/
*.png
*.jpg
*.jpeg
*.svg
*.pdf
!docs/figures/**

# Track / vehicle large binary assets
data/tracks/*/raw/
data/tracks/*/cache/
data/tracks/**/*.kn5
data/tracks/**/*.glb
data/tracks/**/*.fbx
data/tracks/**/*.obj
!data/tracks/**/centerline.csv
!data/tracks/**/README.md

# Profiling / debugging
*.prof
*.log
*.dmp
*.core
core.*
